@{
	ViewData["Title"] = "Dashboard";
}

@{ /* small inline styles scoped to dashboard to match Home page */ }
<text>
<style>
  .dashboard-hero { padding: 36px 12px; }
  .dashboard-card { max-width: 880px; margin: 0 auto; background: #fff; border-radius: 8px; padding: 20px; box-shadow: 0 1px 6px rgba(0,0,0,0.04); }
  .dashboard-header { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; }
  .dashboard-title { font-size: 1.75rem; font-weight:600; }
  .account-info { color:#555; }
  .dashboard-actions { margin-top:12px; }
  .dashboard-actions .btn { margin-right:8px; }
	@@media (min-width:768px) { .dashboard-title { font-size:2rem; } }
</style>
</text>

<div class="dashboard-hero">
	<div class="dashboard-card">
		<div class="dashboard-header">
			<div>
				<div class="dashboard-title">Student Management System</div>
				<div class="account-info">Welcome, <strong>@User.Identity?.Name</strong></div>
			</div>
			<div>
				<a class="btn btn-primary" href="/Students">Manage Students</a>
				<form asp-area="Identity" asp-page="/Account/Logout" method="post" style="display:inline">
					<button type="submit" class="btn btn-outline-secondary">Logout</button>
				</form>
			</div>
		</div>

		<div class="mt-3">
			<p>Manage your student records from your dashboard. Use the Manage Students button to view, add, and edit student information.</p>
		</div>

		<div class="mt-3">
			<h5>Account information</h5>
			<div class="text-muted">Signed in as: <strong>@User.Identity?.Name</strong></div>
			<div class="mt-2">
				<strong>Account Type</strong>
				<div>
					@{
						string role = "User";
						if (User.IsInRole("Admin")) role = "Admin";
						else if (User.IsInRole("User")) role = "User";
					}
					<div class="badge bg-secondary">@role</div>
				</div>
			</div>
		</div>
	</div>
</div>
