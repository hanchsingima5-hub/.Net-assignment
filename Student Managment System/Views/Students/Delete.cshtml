@model WebApplication1.Models.Student

@{
	ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
	<h4>Student</h4>
	<hr />
	<dl class="row">
		<dt class = "col-sm-2">Student ID</dt>
		<dd class = "col-sm-10">@Model.StudentId</dd>

		<dt class = "col-sm-2">Full Name</dt>
		<dd class = "col-sm-10">@Model.FullName</dd>
	</dl>

@{
	var isAdmin = User?.IsInRole("Admin") ?? false;
	if (!isAdmin)
	{
		<text>
			<div class="alert alert-danger">You do not have permission to delete students.</div>
			<a asp-action="Index" class="btn btn-link">Back to List</a>
		</text>
		return;
	}
}
<form asp-action="Delete">
	<input type="hidden" asp-for="Id" />
	<input type="submit" value="Delete" class="btn btn-danger" />
	<a asp-action="Index" class="btn btn-link">Back to List</a>
</form>
</div>
