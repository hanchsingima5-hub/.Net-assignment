@model IEnumerable<StudentManagementSystem.Models.AdminUserViewModel>
@{
	ViewData["Title"] = "Manage Users";
}

<div class="container mt-3">
	<h2>Manage Users</h2>
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
	}
	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
	}
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Email</th>
				<th>Role</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Email</th>
				<th>Roles</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var u in Model)
			{
				<tr>
					<td>@u.Email</td>
					<td>
						@{
							var role = (u.Roles != null && u.Roles.Contains("Admin")) ? "Admin" : "User";
						}
						@role
						@if (string.Equals(User?.Identity?.Name, u.Email, StringComparison.OrdinalIgnoreCase))
						{
							<span class="text-muted"> (You)</span>
						}
					</td>
					<td>
						@{
							var isCurrent = string.Equals(User?.Identity?.Name, u.Email, StringComparison.OrdinalIgnoreCase);
							var isAdmin = u.Roles != null && u.Roles.Contains("Admin");
						}
						@if (!isCurrent)
						{
							if (!isAdmin)
							{
								<form asp-action="MakeAdmin" method="post" style="display:inline">
									<input type="hidden" name="id" value="@u.Id" />
									<button type="submit" class="btn btn-sm btn-primary">Make Admin</button>
								</form>
							}
							else
							{
								<form asp-action="RemoveAdmin" method="post" style="display:inline; margin-right:8px;">
									<input type="hidden" name="id" value="@u.Id" />
									<button type="submit" class="btn btn-sm btn-warning">Remove Admin</button>
								</form>
							}
							<form asp-controller="Admin" asp-action="DeleteUser" method="post" style="display:inline">
								<input type="hidden" name="email" value="@u.Email" />
								<button type="submit" class="btn btn-sm btn-danger">Delete</button>
							</form>
						}
						else
						{
							<span class="text-muted">(You)</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
