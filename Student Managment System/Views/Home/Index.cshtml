@{
    ViewData["Title"] = "Home Page";
}
@{ /* Inline CSS must be inside a Razor expression to avoid parsing issues with @media */ }
<text>
<style>
  .hero {
    padding: 56px 16px 36px;
    text-align: center;
  }
  .hero-panel {
    background: linear-gradient(135deg, rgba(88, 111, 255, 0.12), rgba(0, 202, 157, 0.12));
    border: 1px solid rgba(111, 124, 255, 0.2);
    border-radius: 28px;
    box-shadow: 0 18px 45px rgba(58, 74, 146, 0.12);
    padding: 44px 24px;
  }
  .hero-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    background: linear-gradient(90deg, #4d5df1, #00b894, #00a6ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-desc {
    color: #4a5572;
    margin-bottom: 2rem;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.06rem;
    line-height: 1.8;
  }
  .cta-group {
    gap: 0.9rem !important;
    margin-bottom: 2rem;
  }
  .cta-group .btn {
    padding: 0.85rem 1.4rem;
    font-size: 1rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .cta-group .btn-primary {
    background: linear-gradient(135deg, #4e6cf5, #7d4ef2);
    border: none;
    box-shadow: 0 12px 28px rgba(92, 107, 247, 0.28);
  }
  .cta-group .btn-outline-secondary {
    border-color: rgba(77, 93, 241, 0.3);
    color: #2c3b75;
    background: rgba(255, 255, 255, 0.6);
  }
  .features {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .feature {
    background: rgba(255,255,255,0.8);
    border: 1px solid rgba(110, 124, 255, 0.12);
    border-radius: 18px;
    padding: 20px 18px;
    min-width: 220px;
    max-width: 300px;
    text-align: left;
    box-shadow: 0 12px 28px rgba(80, 96, 151, 0.08);
  }
  .feature strong {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 1.07rem;
    color: #1e2a59;
  }
  .feature .text-muted {
    color: #58647f !important;
    line-height: 1.6;
  }
  .feature-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    margin-right: 10px;
    font-size: 1.2rem;
    background: linear-gradient(135deg, #e0ebff, #d7ffef);
  }
  .hero-footer {
    margin-top: 2.3rem;
    padding: 14px 0 8px;
    color: #4d5a78;
    font-size: 1rem;
  }
  @@media (min-width: 768px) {
    .hero-title { font-size: 3.4rem; }
  }
</style>
</text>

<div class="hero">
    <div class="container hero-panel">
        <h1 class="hero-title">Student Management System</h1>
        <p class="hero-desc">A simple, secure student records system for managing student information, courses, and semesters. Designed as a concise college project to demonstrate CRUD operations, authentication, and a clean user experience.</p>

        <div class="d-flex justify-content-center flex-wrap cta-group">
            <a class="btn btn-primary" href="/Students">Manage Students</a>

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <a class="btn btn-outline-secondary" href="/">Welcome, @User.Identity.Name</a>
            }
            else
            {
                <a class="btn btn-outline-secondary" href="/Identity/Account/Login">Login / Register</a>
            }
        </div>

        <div class="features" role="list">
            <div class="feature" role="listitem">
                <div><span class="feature-badge">📚</span><strong>Student Records</strong></div>
                <div class="text-muted">Create, view, and edit student profiles and contact information.</div>
            </div>
            <div class="feature" role="listitem">
                <div><span class="feature-badge">⚙️</span><strong>Easy Management</strong></div>
                <div class="text-muted">Intuitive forms and validation for adding and updating data quickly.</div>
            </div>
            <div class="feature" role="listitem">
                <div><span class="feature-badge">🔒</span><strong>Secure Access</strong></div>
                <div class="text-muted">Built-in authentication ensures only authorized users can manage students.</div>
            </div>
        </div>

        <div class="hero-footer">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <p>Welcome back, <strong>@User.Identity.Name</strong>. Use the Manage Students button above to view and edit student records.</p>
            }
            else
            {
                <p>You can browse the application, but the <strong>Manage Students</strong> section requires an account. Click Login/Register to get started.</p>
            }
        </div>
    </div>
</div>
