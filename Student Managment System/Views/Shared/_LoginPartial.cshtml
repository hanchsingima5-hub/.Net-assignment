@using Microsoft.AspNetCore.Identity
@using StudentManagementSystem.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
	// Resolve current user when signed in to display email/username
	ApplicationUser? currentUser = null;
	if (SignInManager.IsSignedIn(User))
	{
		currentUser = await UserManager.GetUserAsync(User);
	}
}

@if (SignInManager.IsSignedIn(User))
{
	<ul class="navbar-nav">
		<li class="nav-item">
			<span class="nav-link">@((currentUser?.Email) ?? User.Identity?.Name)</span>
		</li>
		<li class="nav-item">
			<form asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm" class="form-inline">
				<button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
			</form>
		</li>
	</ul>
}
else
{
	<ul class="navbar-nav">
		<li class="nav-item">
			<a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
		</li>
	</ul>
}
