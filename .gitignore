## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build & output
bin/
obj/

# VS workspace
.vs/

# Rider
.idea/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# DotNet
*.dbmdl
*.psess
*.vsp
*.userprefs

# NuGet
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio Code
.vscode/

# LocalDB / SQL Server Express database files
*.mdf
*.ldf

# Secrets and env files
.env
secrets.json
usersecrets.json
appsettings.json

# certificate files
*.pfx
*.pem
*.key

# IIS Express
applicationhost.config

# Misc
Thumbs.db
ehthumbs.db
Desktop.ini
